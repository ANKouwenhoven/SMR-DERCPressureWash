#define PULSE_PIN  9
#define DIR_PIN    8
#define MICROSTEPS 10.00
#define DIRECTION  HIGH
#define STEPS_PER_REV (199.4 * MICROSTEPS)
#define STEPS_PER_SHOT (STEPS_PER_REV / 35)
#define DEFAULT_RPM 3
#define GEAR_RATIO 16

float rpm = DEFAULT_RPM;
unsigned long stepPeriodUs = 0;
bool running = false;
String serialBuffer = "";

void recalculate() {
  stepPeriodUs = (unsigned long)(60000000L / (rpm * STEPS_PER_REV));
}

void rotateSteps(long steps) {

  long GearedSteps = steps * GEAR_RATIO;

  long rampSteps = (long)((4.0 / 360.0) * STEPS_PER_REV);  // always 4°
  rampSteps = min(rampSteps, steps / 2);                    // safety: short moves

  for (long i = 0; i < GearedSteps; i++) {
    unsigned long period;
    if (i < rampSteps) {
      period = 2000 + (2000 * 5 * (rampSteps - i) / rampSteps);
    } else if (i > GearedSteps - rampSteps) {
      period = 2000 + (2000 * 5 * (i - (GearedSteps - rampSteps)) / rampSteps);
    } else {
      period = 2000;
    }
    digitalWrite(PULSE_PIN, HIGH);
    delayMicroseconds(50);
    digitalWrite(PULSE_PIN, LOW);
    delayMicroseconds(period);
  }
}

void handleCommand(String cmd) {
  cmd.trim();
  cmd.toUpperCase();
  if (cmd == "ROTATE") {
    rotateSteps(STEPS_PER_SHOT);
    Serial.println("DONE");
  } else if (cmd == "RUN") {
    running = true;
    Serial.println(">> Running continuously — send STOP to halt");
  } else if (cmd == "STOP") {
    running = false;
    Serial.println(">> Stopped");
  } else if (cmd.startsWith("RPM:")) {
    float val = cmd.substring(4).toFloat();
    if (val > 0) {
      rpm = val;
      recalculate();
      Serial.print(">> RPM set to "); Serial.println(rpm);
    }
  } else if (cmd.startsWith("DEG:")) {                          // NEW
    float degrees = cmd.substring(4).toFloat();                 //
    if (degrees > 0 && degrees <= 1080) {                        //
      long steps = (long)((degrees / 360.0) * STEPS_PER_REV);  //
      if (steps < 3) {                                          //
        Serial.println("!! Too few steps for ramp — increase degrees");
      } else {                                                  //
        Serial.print(">> Rotating ");                           //
        Serial.print(degrees);                                  //
        Serial.print(" deg (");                                 //
        Serial.print(steps);                                    //
        Serial.println(" steps)");                              //
        rotateSteps(steps);                                     //
        Serial.println("DONE");                                 //
      }                                                         //
    } else {                                                    //
      Serial.println("!! DEG must be > 0 and <= 360");          //
    }                                                           // END NEW
  } else if (cmd.startsWith("REPEAT:")) {
    int count = cmd.substring(7).toInt();
    if (count > 0) {
      Serial.print(">> Repeating ");
      Serial.print(count);
      Serial.println(" times");
      for (int i = 0; i < count; i++) {
        rotateSteps(STEPS_PER_SHOT);
        Serial.print(">> Step ");
        Serial.print(i + 1);
        Serial.print(" of ");
        Serial.println(count);
        delay(1000);
      }
      Serial.println("DONE");
    }
  } else if (cmd == "FULL") {
    Serial.println(">> Full rotation, 90 steps");
    for (int i = 0; i < 90; i++) {
      rotateSteps(STEPS_PER_SHOT);
      Serial.print(">> Step ");
      Serial.print(i + 1);
      Serial.println(" of 90");
      delay(1000);
    }
    Serial.println("DONE");
  } else {
    Serial.println("!! Unknown command. Use: ROTATE | FULL | RUN | STOP | RPM:3 | REPEAT:N | DEG:90");
  }
}

void setup() {
  pinMode(PULSE_PIN, OUTPUT);
  pinMode(DIR_PIN,   OUTPUT);
  digitalWrite(DIR_PIN, DIRECTION);
  Serial.begin(9600);
  recalculate();
  Serial.println("READY");
}

void loop() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (serialBuffer.length() > 0) {
        handleCommand(serialBuffer);
        serialBuffer = "";
      }
    } else {
      serialBuffer += c;
    }
  }
  if (running) {
    digitalWrite(PULSE_PIN, HIGH);
    delayMicroseconds(50);
    digitalWrite(PULSE_PIN, LOW);
    delayMicroseconds(stepPeriodUs);
  }
}
